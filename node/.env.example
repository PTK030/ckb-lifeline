# Copy to .env and fill in. `docker compose up -d` in this directory reads it.

# The node's domain. Its A (and AAAA, if you have IPv6) record must point at
# this server before the certificate can be issued.
DOMAIN=ckb1.example.org

# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=ops@example.org

# mainnet or testnet.
CKB_NETWORK=mainnet

# Exact versions, so that every operator runs what was tested.
CKB_IMAGE=nervos/ckb:v0.210.0
NGINX_IMAGE=nginx:1.30.6-alpine
CERTBOT_IMAGE=certbot/certbot:v5.9.0

# The node's P2P port for other full nodes. Port 443 also takes P2P.
P2P_PORT=8115

# A public JSON-RPC at https://DOMAIN/rpc: read methods, the indexer and
# send_transaction only, limited per IP. Off unless you mean to run one;
# docs/rpc.md explains what it costs. Turning it on adds the indexer to the node.
RPC_PUBLIC=false
RPC_RATE=10r/s
RPC_BURST=20

# info, or e.g. info,ckb-network=debug when looking into connections.
CKB_LOG=info
