{
  "name": "ckb-lifeline",
  "private": true,
  "description": "Commands for the whole repository; the tools live in packages/.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run build && npm test && node .github/scripts/commit-subject.mjs --all",
    "lifeline": "node packages/cli/bin/lifeline.js",
    "devnet:up": "node devnet/up.mjs",
    "devnet:down": "node devnet/down.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
